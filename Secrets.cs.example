using System;

namespace FilumDLWPF
{
    /// <summary>
    /// Secrets class to store sensitive API credentials
    /// This file should not be committed to source control
    /// Each developer should create their own version with their API keys
    /// 
    /// INSTRUCTIONS:
    /// 1. Copy this file and rename it to "Secrets.cs"
    /// 2. Replace the placeholder values with your actual API credentials
    /// 3. Never commit Secrets.cs to git (it's already in .gitignore)
    /// </summary>
    public class Secrets
    {
        /// <summary>
        /// Returns the Spotify Client ID
        /// Get your credentials from: https://developer.spotify.com/dashboard/applications
        /// </summary>
        /// <returns>Spotify Client ID</returns>
        public string SetSpotifyClientID()
        {
            // TODO: Replace with your actual Spotify Client ID
            // To get credentials:
            // 1. Go to https://developer.spotify.com/dashboard/applications
            // 2. Log in with your Spotify account
            // 3. Create an app or use an existing one
            // 4. Copy the Client ID from your app settings
            return "YOUR_SPOTIFY_CLIENT_ID_HERE";
        }

        /// <summary>
        /// Returns the Spotify Client Secret
        /// Get your credentials from: https://developer.spotify.com/dashboard/applications
        /// </summary>
        /// <returns>Spotify Client Secret</returns>
        public string SetSpotifyClientSecret()
        {
            // TODO: Replace with your actual Spotify Client Secret
            // To get credentials:
            // 1. Go to https://developer.spotify.com/dashboard/applications
            // 2. Log in with your Spotify account
            // 3. Create an app or use an existing one
            // 4. Copy the Client Secret from your app settings
            return "YOUR_SPOTIFY_CLIENT_SECRET_HERE";
        }
    }
}
